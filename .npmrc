verify-deps-before-run=false

# node_modules achatado, como o npm faz.
#
# O layout padrão do pnpm (isolated) monta tudo em `.pnpm/` e liga por symlink.
# A Vercel não aceita isso numa Serverless Function: o deploy falha com
# "The framework produced an invalid deployment package for a Serverless
# Function. Typically this means that the framework produces files in symlinked
# directories." Era também o motivo de o `libvips-cpp.so` do sharp não chegar
# no bundle — o rastreador do Next não atravessava os symlinks até ele.
node-linker=hoisted
