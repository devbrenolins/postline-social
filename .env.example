# ------------------------------------------------------------------
#  App
# ------------------------------------------------------------------
# URL pública do app (usada em OAuth, webhooks e no manifest do PWA).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------
#  Banco de dados (Postgres do Supabase — aba Project Settings > Database)
# ------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# ------------------------------------------------------------------
#  Supabase Auth (aba Project Settings > API)
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------
#  Google Gemini (roteiros, criativos e pesquisa)
#  Chave gratuita em https://aistudio.google.com/apikey
#  Os modelos abaixo são opcionais — sem eles o app usa os padrões e ainda
#  faz fallback automático para outro modelo se a cota do dia acabar.
# ------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ------------------------------------------------------------------
#  Cloudflare Workers AI (geração de criativos)
#  Os modelos de imagem do Gemini têm cota ZERO no tier gratuito, então os
#  criativos usam a Cloudflare — conta gratuita, 10.000 neurons/dia, sem cartão.
#  Account ID: dash.cloudflare.com → Workers & Pages (fica na barra lateral).
#  Token: My Profile → API Tokens → Create Token → template "Workers AI".
# ------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Opcional: força um modelo. Padrão = @cf/black-forest-labs/flux-2-klein-4b
CLOUDFLARE_IMAGE_MODEL=

# ------------------------------------------------------------------
#  OpenAI (criativos com texto desenhado pelo próprio modelo) — PAGO
#  É o único provedor que escreve texto legível dentro da arte. Sem tier
#  gratuito: cerca de US$ 0,02 a US$ 0,20 por imagem, conforme a qualidade.
#  Chave em https://platform.openai.com/api-keys
#  Quando OPENAI_API_KEY existe, ela vira o provedor de imagem automaticamente.
# ------------------------------------------------------------------
OPENAI_API_KEY=
# Opcional. Padrão = gpt-image-2 (cai para gpt-image-1.5 / gpt-image-1)
OPENAI_IMAGE_MODEL=
# Opcional: low | medium | high | auto. Padrão = high (texto mais nítido)
OPENAI_IMAGE_QUALITY=

# Opcional: força o provedor de imagem — "openai", "cloudflare" ou "gemini".
# Vazio = openai se houver OPENAI_API_KEY, senão cloudflare, senão gemini.
IMAGE_PROVIDER=

# ------------------------------------------------------------------
#  Instagram (API with Instagram Login — login direto pelo Instagram)
#  App em developers.facebook.com → produto "Instagram" → API setup with Instagram login.
#  Use o Instagram App ID/Secret (NÃO o do Facebook). Conta precisa ser Business/Creator.
#  Callback OAuth: <APP_URL>/api/meta/connect/callback   Webhook: <APP_URL>/api/meta/webhook
# ------------------------------------------------------------------
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0
# Legado (fallback): usados se INSTAGRAM_APP_ID/SECRET não estiverem definidos
META_APP_ID=
META_APP_SECRET=
# Legado (fallback de conta única; a integração multi-conta usa tokens por conta no banco)
# ----------------------------------------------------------------------
# X (Twitter) — API v2, plano gratuito
# Portal: https://developer.x.com → Projects & Apps → seu app → User
# authentication settings (OAuth 2.0, tipo "Web App", Confidential client).
# Callback: https://SEU_DOMINIO/api/x/connect/callback
# ----------------------------------------------------------------------
# ----------------------------------------------------------------------
# TikTok — Login Kit + Content Posting API (gratuita)
# Portal: https://developers.tiktok.com → seu app
# Callback (precisa ser HTTPS): https://SEU_DOMINIO/api/tiktok/connect/callback
# Exige verificar o domínio das mídias em "URL properties" e passar pela
# auditoria do app — sem ela, todo post sai como privado.
# ----------------------------------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

X_CLIENT_ID=Z2prQTRWbkI1aGl6dFBnYVAxblk6MTpjaQ
X_CLIENT_SECRET=cBIMJRgyrdLwLDnYwzWo9JXr58YHzyOazJ1sSUnTe-71oTJ6vv
# Freio de gasto: o X cobra por publicação (US$ 0,015, ou US$ 0,20 com link).
X_MONTHLY_POST_LIMIT=450

META_ACCESS_TOKEN=
META_IG_USER_ID=
META_WORKSPACE_ID=

# ------------------------------------------------------------------
#  Publicação agendada (Vercel Cron chama /api/cron/publish)
# ------------------------------------------------------------------
CRON_SECRET=
